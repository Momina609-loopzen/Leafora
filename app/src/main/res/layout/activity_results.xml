<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B5DFB2"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="22dp"
      android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌿 Leafora"
        android:textColor="#174D35"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Plant Analysis"
        android:textColor="#174D35"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="190dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="4dp">

      <ImageView
          android:id="@+id/resultImage"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:contentDescription="Selected plant image"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="3dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detection Result"
            android:textColor="#526B54"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtDiseaseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for prediction..."
            android:textColor="#174D35"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/txtPlantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analysis Pending"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#B9785C"
            android:padding="10dp"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/txtConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confidence: --"
            android:textColor="#526B54"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>

      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlantCare"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Plant Care Tips"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="15dp"
        app:cornerRadius="22dp"
        app:backgroundTint="#174D35"/>

  </LinearLayout>

</ScrollView>